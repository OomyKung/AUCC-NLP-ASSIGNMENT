# ============================================================================
#  Thai News Intelligence Dashboard - environment configuration
#  Copy to `.env` and edit. Every value here has a working default, so the
#  application runs with no .env file at all.
# ============================================================================

# ----------------------------------------------------------------- application
APP_NAME="Thai News Intelligence"
DEBUG=true

# ------------------------------------------------------------------- database
# SQLite by default. Point at Postgres/MySQL later without code changes.
# DATABASE_URL=sqlite:///./thai_news.db
SQL_ECHO=false

# ---------------------------------------------------------------- NLP backends
# Swap any model by changing one value here. See backend/app/nlp/registry.py.
# Every default below is a measured choice, not a preference -- the numbers are
# in the README's Results section.
#   NLP_TOKENIZER          : newmm | newmm-safe | longest | mm
#   NLP_TOPIC_BACKEND      : sklearn | blend | transformer
#   NLP_SENTIMENT_BACKEND  : sklearn | blend | lexicon | transformer  (documents)
#   NLP_SUMMARIZER_BACKEND : extractive | llm
#   NLP_NER_BACKEND        : rules | pythainlp
NLP_TOKENIZER=newmm

# Topic blends the trained model with the gazetteer. They make different
# mistakes, so averaging their probabilities wins: cross-validated macro-F1
# 0.720 -> 0.740, held-out 0.725 -> 0.763.
NLP_TOPIC_BACKEND=blend

# Sentiment does NOT blend. The same fitting procedure chose alpha = 1.00 for
# it -- with tuned hyperparameters the trained model had absorbed everything the
# lexicon contributed (CV 0.7081 alone vs 0.7084 blended). Defaulting to "blend"
# would add a component the measurement says does no work.
NLP_SENTIMENT_BACKEND=sklearn

# Blend weights: P = alpha * P_model + (1 - alpha) * P_rules. Fitted by
# `python ensemble.py` on out-of-fold training predictions, never on the
# held-out set. 1.0 = trained model alone; 0.0 = rule baseline alone.
NLP_TOPIC_BLEND_ALPHA=0.85
NLP_SENTIMENT_BLEND_ALPHA=1.0

# Per-message chat sentiment uses a SEPARATE backend, because the gap between
# news prose and live-chat register is large in BOTH directions: the
# news-trained model scores 0.319 on the Wisesight test split, and a
# Wisesight-trained model scores 0.287 on the news split. Each collapses on the
# other's domain.
#
# "wisesight" is TF-IDF trained on ~23.5k real Thai social-media messages
# (0.710 accuracy / 0.673 macro-F1 on that corpus's official test split). It
# replaced the lexicon, which scores 0.436 macro-F1 on those same rows. The
# lexicon stays as the fallback if the artefact is missing.
# Retrain with: pip install -r backend/requirements-training.txt
#               python train_chat_sentiment.py
#   NLP_CHAT_SENTIMENT_BACKEND : wisesight | sklearn | lexicon | transformer
NLP_CHAT_SENTIMENT_BACKEND=wisesight
NLP_SUMMARIZER_BACKEND=extractive
NLP_NER_BACKEND=rules

# Optional Hugging Face models, used only when a transformer backend is selected.
# Requires: pip install -r backend/requirements-training.txt
# HF_SENTIMENT_MODEL=phoner45/wangchan-sentiment-thai-text-model
# HF_TOPIC_MODEL=airesearch/wangchanberta-base-att-spm-uncased

# --------------------------------------------------------------- summarization
SUMMARY_MIN_SENTENCES=2
SUMMARY_MAX_SENTENCES=4

# Optional external LLM summarizer. Leave blank to use the offline extractive
# summarizer -- the application is fully functional without a key.
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5

# --------------------------------------------------- YouTube live chat ingestion
# COLLECTOR: ytdlp (no API key, works on live + archived streams)
#          | youtube_api (official API, needs a key, live broadcasts only)
#          | file (replay a committed snapshot, fully offline)
COLLECTOR=ytdlp

# Only needed when COLLECTOR=youtube_api
# YOUTUBE_API_KEY=

# A chat window closes at whichever bound is reached first. CHAT_WINDOW_SIZE is
# the bound that normally governs; CHAT_WINDOW_MINUTES is a safety valve so a
# quiet stream cannot produce one enormous window. Set it to 0 to disable the
# time bound entirely and window purely by message count.
CHAT_WINDOW_SIZE=200
CHAT_WINDOW_MINUTES=60
CHAT_WINDOW_MIN_MESSAGES=5

# Live monitoring poll interval and per-import safety cap.
LIVE_POLL_SECONDS=10
MAX_MESSAGES_PER_IMPORT=20000
