# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Environment ----
.env
.env.local

# ---- Database ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- Trained model artefacts ----
# The fitted models (3.7 MB) and their metrics ARE committed, so a fresh clone
# runs with the trained pipeline and a populated Evaluation page without anyone
# having to train first. Regenerate them with:
#   python build_dataset.py && python train.py && python evaluate.py
backend/models/*.joblib

# Fine-tuned transformer weights (~420 MB each). Regenerate with:
#   pip install torch transformers sentencepiece protobuf
#   python train_transformer.py
# Their metrics ARE committed, so the comparison tables stay reproducible.
backend/models/wangchanberta_*/

# ---- Downloaded corpora ----
# The Wisesight corpus cache (~6 MB) is NOT committed: it is a third-party
# corpus with its own provenance, and it is regenerable with one command.
# The model trained from it IS committed, so a fresh clone needs no download.
#   pip install -r requirements-training.txt
#   python train_chat_sentiment.py
data/wisesight/

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
npm-debug.log*
